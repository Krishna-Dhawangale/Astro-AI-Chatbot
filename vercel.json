{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/chat",
      "destination": "https://astro-ai-chatbot.onrender.com/chat"
    },
    {
      "source": "/health",
      "destination": "https://astro-ai-chatbot.onrender.com/health"
    },
    {
      "source": "/api/:match*",
      "destination": "https://astro-ai-chatbot.onrender.com/api/:match*"
    },
    {
      "source": "/admin/:match*",
      "destination": "https://astro-ai-chatbot.onrender.com/admin/:match*"
    },
    {
      "source": "/((?!.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
