# ==============================================================================
# Astrology AI Chatbot - Environment Configuration (.env.example)
# Production setup for 7,000–9,000 DAU completely on Free-Tier APIs
# ==============================================================================

# 1. Primary AI Provider: Groq (Cascading 8-Model Free-Tier Chain)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Secondary Provider Safety Net: Google Gemini (gemini-2.0-flash)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Optional Ephemeris / Natal Chart Services (Free Tiers)
FREE_ASTROLOGY_API_KEY=your_free_astrology_api_key_here
PROKERALA_CLIENT_ID=your_prokerala_client_id_here
PROKERALA_CLIENT_SECRET=your_prokerala_client_secret_here

# 4. Server Configuration
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_STORAGE_URI=memory://
